#!/sbin/openrc-run

# Project Navi - Alpine Linux OpenRC Service (BUN with Autorestart)
# Installation:
# 1. Copy this file to /etc/init.d/project-navi
# 2. chmod +x /etc/init.d/project-navi
# 3. rc-update add project-navi default
# 4. rc-service project-navi start

name="project-navi"
description="Project Navi - Advanced Finance Protocol (Bun)"

# Use supervise-daemon for automatic restarts
supervisor="supervise-daemon"
respawn_delay=5
respawn_max=10

# Directory where the project is installed
directory="/opt/project-navi"

# Start command using Bun
command="bun"
command_args="run start"

# Process management
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/project-navi.log"
error_log="/var/log/project-navi.err"

# supervise-daemon specific logs
supervise_daemon_args="--stdout $output_log --stderr $error_log"

# Environment configuration
export NODE_ENV="production"
export PORT="${PORT:-3000}"

# Dependencies
depend() {
    need net
    after firewall
}

start_pre() {
    # Ensure the directory exists
    if [ ! -d "$directory" ]; then
        eerror "Directory $directory not found!"
        return 1
    fi

    # Ensure log files exist and are writable
    touch "$output_log" "$error_log"
}
