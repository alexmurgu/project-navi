#!/sbin/openrc-run

# Project Navi - Alpine Linux OpenRC Service
# Installation:
# 1. Copy this file to /etc/init.d/project-navi
# 2. chmod +x /etc/init.d/project-navi
# 3. rc-update add project-navi default
# 4. rc-service project-navi start

name="project-navi"
description="Project Navi - Advanced Finance Protocol"

# Directory where the project is installed
directory="/opt/project-navi"

# Start command (using npm start which calls next start)
command="/usr/bin/npm"
command_args="start"

# Process management
pidfile="/run/${RC_SVCNAME}.pid"
command_background="yes"
output_log="/var/log/project-navi.log"
error_log="/var/log/project-navi.err"

# Environment configuration
# You can also use an .env file in the directory
export NODE_ENV="production"
export PORT="${PORT:-3000}"

# Dependencies
depend() {
    need net
    after firewall
}

start_pre() {
    # Ensure the directory exists
    if [ ! -d "$directory" ]; then
        eerror "Directory $directory not found!"
        return 1
    fi

    # Ensure log files exist and are writable
    touch "$output_log" "$error_log"
    # chown node:node "$output_log" "$error_log" # If running as non-root
}

stop_post() {
    # Clean up pid file if needed
    rm -f "$pidfile"
}
